{
  "outputDirectory": "out",
  "redirects": [
    {
      "source": "/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/en/contact/",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/en/products/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/en/blog/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/en/about/",
      "permanent": true
    },
    {
      "source": "/solutions",
      "destination": "/en/solutions/",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/en/faq/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/en/privacy/",
      "permanent": true
    },
    {
      "source": "/:locale(en|ar|de|es|fr|id|pt|ru|th|tr|vi)",
      "destination": "/:locale/",
      "permanent": true
    },
    {
      "source": "/:locale(en|ar|de|es|fr|id|pt|ru|th|tr|vi)/products/category/(cummins|sdec|weichai|volvo|yuchai|kaichen)",
      "destination": "/:locale/products/categories/$1/",
      "permanent": true
    },
    {
      "source": "/:locale(en|ar|de|es|fr|id|pt|ru|th|tr|vi)/products/category/(perkins|doosan|mitsubishi|scania|shangchai)",
      "destination": "/:locale/products/",
      "permanent": true
    },
    {
      "source": "/:locale(en|ar|de|es|fr|id|pt|ru|th|tr|vi)/solutions/(industrial|commercial|construction|telecom)",
      "destination": "/:locale/solutions/",
      "permanent": true
    },
    {
      "source": "/:locale(en|ar|de|es|fr|id|pt|ru|th|tr|vi)/:path",
      "destination": "/:locale/:path/",
      "permanent": true
    }
  ]
}
